# Local values and keys. make setup copies this file to .env, which is not
# in git. make passes every value to every target as an environment
# variable, and Kirby reads DEBUG and ANTHROPIC_API_KEY from there. The
# workflows use the same names for the secrets and variables of the
# repository.

# The URL of the live site, without a slash at the end.
SITE_URL=https://example.com

# The ssh target of the server: an alias from ~/.ssh/config, or user@host.
DEPLOY_HOST=website

# The folder of the site on the server. It has the name of the domain of
# SITE_URL.
DEPLOY_PATH=/www/htdocs/<account>/example.com

# Kirby's debug mode for make dev: an error shows its message and the call
# stack instead of an empty page.
DEBUG=true

# The key of the assistant in the Panel. Empty turns the assistant off.
ANTHROPIC_API_KEY=

# The key for make speed (PageSpeed Insights by Google).
PAGESPEED_API_KEY=
