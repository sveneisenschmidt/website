# Lokale Werte und Schlüssel. make setup kopiert diese Datei nach .env, die
# nicht in Git ist. make gibt jeden Wert als Umgebungsvariable an jedes Ziel
# weiter, und Kirby liest DEBUG und ANTHROPIC_API_KEY daraus. Die Workflows
# nutzen dieselben Namen als Secrets und Variablen des Repos.

# Die Adresse der Live-Seite, ohne / am Ende.
SITE_URL=https://example.com

# Das SSH-Ziel des Servers: ein Alias aus ~/.ssh/config oder user@host.
DEPLOY_HOST=website

# Der Ordner der Seite auf dem Server. Er heißt wie die Domain aus SITE_URL.
DEPLOY_PATH=/www/htdocs/<konto>/example.com

# Kirbys Debug-Modus für make dev: Ein Fehler zeigt die Meldung und die
# Aufrufkette statt einer leeren Seite.
DEBUG=true

# Der Schlüssel für den Assistenten im Panel. Leer ist der Assistent aus.
ANTHROPIC_API_KEY=

# Der Schlüssel für make speed (PageSpeed Insights von Google).
PAGESPEED_API_KEY=
