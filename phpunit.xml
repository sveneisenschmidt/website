<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnPhpunitDeprecation="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <!-- A deprecation or notice fails the run only when it comes from the code of this repository, not from Kirby or vendor/. -->
    <source restrictNotices="true" ignoreIndirectDeprecations="true">
        <include>
            <directory>src</directory>
            <directory>www/site</directory>
            <directory>bin</directory>
            <directory>tests</directory>
        </include>
    </source>
</phpunit>
