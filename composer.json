{
    "name": "sveneisenschmidt/website",
    "description": "The website sven.eisenschmidt.website, built with Kirby. Composer installs Kirby into www/kirby and the other packages into vendor/, outside www/, where the web server cannot reach them.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "fabianmichael/kirby-markdown-field": "^4.0",
        "getkirby/cms": "^5.6.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "getkirby/composer-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "kirby-cms-path": "www/kirby",
        "kirby-plugin-path": "www/site/plugins"
    },
    "autoload": {
        "psr-4": {
            "Website\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Website\\Tests\\": "tests/"
        }
    }
}
