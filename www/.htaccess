# Kirby .htaccess

Options -Indexes

<IfModule mod_rewrite.c>

RewriteEngine on

# Block files and folders beginning with a dot, such as .git,
# except for the .well-known folder
RewriteRule (^|/)\.(?!well-known\/) index.php [L]

# Block direct access to content, site and kirby folders
RewriteRule ^content/(.*) index.php [L]
RewriteRule ^site/(.*) index.php [L]
RewriteRule ^kirby/(.*) index.php [L]

# Send every path that is not an existing file or folder to Kirby
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*) index.php [L]

</IfModule>

# Kirby renders the 404 page, and Website\Blog\Router answers the redirects
# in content/.redirects.json. This file therefore has no ErrorDocument and
# no Redirect rules.

# Content-Type
AddDefaultCharset UTF-8
AddType application/javascript .js
AddType application/json .json
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddType font/woff .woff

# No ETags. Fonts, images, CSS and JS are cached for a year and get a new
# URL when they change, so a browser never needs to revalidate them.
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# Compression
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# Caching: fonts, images and CSS/JS for a year, HTML never. A thumbnail
# under media/ gets a new URL when its image changes. A CSS or JS file gets
# ?v= with its modification time from Layout::asset().
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ttf|woff|woff2|jpg|jpeg|png|gif|webp|svg|ico|css|js)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>
