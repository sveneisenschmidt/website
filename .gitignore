# macOS
.DS_Store

# Editor
/.zed/

# Lokale Dateien für Claude
/.claude/

# Lokale Design-Notizen
/.design/
/DESIGN.md

# Datenbanken: Besucherdaten gehören nie in dieses öffentliche Repository.
*.db
*.sqlite*

# Lokale Einstellungen für das Makefile, etwa der Ordner auf dem Server. Er nennt das Hosting-Konto.
/.env

# Kirby: der Zustand der Seite (Inhalte, Konten, .salt, .license) und env.php.
# Den Zustand sichert bin/backup.sh, env.php hat jeder Host für sich.
/www/content/
/www/site/accounts/
/www/site/config/env.php
/www/site/config/.salt
/www/site/config/.license

# Kirby: erzeugte Dateien. Kirby erzeugt sie aus den Inhalten neu.
/www/media/
/www/site/cache/
/www/site/sessions/
/www/site/logs/

# Kirby: von Composer installiert
/www/kirby/
/vendor/
# Plugins aus Composer; nur die eigenen Plugins (blog, changelog, analytics, assistant) liegen in Git.
/www/site/plugins/*
!/www/site/plugins/blog/
!/www/site/plugins/changelog/
!/www/site/plugins/analytics/
!/www/site/plugins/assistant/

# Assistent: Uploads der Chats neben www/ (src/Assistant/Uploads.php)
/storage/

# Lokale Ausgabe: Backups, Restore-Test, PHPUnit, Formatierer
/backups/
/.restore-test/
/.phpunit.cache/
/.php-cs-fixer.cache
