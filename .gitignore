# macOS
.DS_Store

# Editor
/.zed/

# Local files of Claude Code
/.claude/

# Local design notes
/.design/
/DESIGN.md

# Databases: visitor data must never reach this public repository.
*.db
*.sqlite*

# Local values and keys (template: .env.example). The server folder in it
# names the hosting account.
/.env
/.env.*
!/.env.example

# Kirby: the state of the site (content, accounts, .salt, .license) and
# env.php. bin/backup.sh saves the state; each host has its own env.php.
/www/content/
/www/site/accounts/
/www/site/config/env.php
/www/site/config/.salt
/www/site/config/.license

# Kirby: generated files. Kirby creates them again from the content.
/www/media/
/www/site/cache/
/www/site/sessions/
/www/site/logs/

# Installed by Composer
/www/kirby/
/vendor/
# Plugins from Composer. Only the plugins of this site (blog, changelog,
# analytics, assistant, likes) are in git.
/www/site/plugins/*
!/www/site/plugins/blog/
!/www/site/plugins/changelog/
!/www/site/plugins/analytics/
!/www/site/plugins/assistant/
!/www/site/plugins/likes/

# Files next to www/ that the web server must not serve and no backup
# includes: the assistant's uploads (src/Assistant/Uploads.php), the key of
# the visitor statistics (src/Analytics/Fingerprint.php) and, locally, the
# mails of bin/mail-catcher.php.
/storage/

# Local output: backups, the restore test, PHPUnit, the formatter
/backups/
/.restore-test/
/.phpunit.cache/
/.php-cs-fixer.cache
