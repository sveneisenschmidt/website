# macOS
.DS_Store

# Editor
/.zed/

# Lokale Dateien für Claude
/.claude/

# Lokale Design-Notizen
/.design/
/DESIGN.md

# Lokale Einstellungen für das Makefile, z. B. der Ordner auf dem Server (nennt das Hosting-Konto)
/.env

# Kirby: Zustand lebt in Backups, nie in Git
/www/content/
/www/site/accounts/
/www/site/config/env.php
/www/site/config/.salt
/www/site/config/.license

# Kirby: erzeugt, entsteht aus den Inhalten neu
/www/media/
/www/site/cache/
/www/site/sessions/
/www/site/logs/

# Kirby: von Composer installiert
/www/kirby/
/vendor/
# Plugins aus Composer; nur die eigenen Plugins (blog, changelog, analytics, assistant) liegen in Git.
/www/site/plugins/*
!/www/site/plugins/blog/
!/www/site/plugins/changelog/
!/www/site/plugins/analytics/
!/www/site/plugins/assistant/

# Assistent: Uploads der Chats, neben www/ und vendor/, nie in Git
/storage/

# Lokale Ausgabe: Backups, Restore-Test, PHPUnit
/backups/
/.restore-test/
/.phpunit.cache/
