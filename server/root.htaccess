# .htaccess in the site folder on the server, next to www/ and vendor/
# (the deploy uploads it from server/root.htaccess). The document root in KAS
# is the site folder: every request goes into www/, so vendor/, storage/
# and backups/ are not reachable from outside. www/.htaccess has Kirby's
# rules.

RewriteEngine On

# Let's Encrypt (HTTP-01) reads /.well-known/ from this folder.
RewriteRule ^\.well-known/ - [L]

# The folder also answers as kirby.eisenschmidt.website: every other host
# name leads to the one address.
RewriteCond %{HTTP_HOST} !^sven\.eisenschmidt\.website$ [NC]
RewriteRule ^(.*)$ https://sven.eisenschmidt.website/$1 [R=301,L]

RewriteRule ^(.*)$ www/$1 [L]
