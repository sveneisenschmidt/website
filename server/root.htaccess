# The .htaccess of the site folder on the server. In KAS, the admin panel of
# the hosting provider All-Inkl, the site folder is the document root.
# bin/deploy.sh puts the id of the new release in place of RELEASE_ID and
# uploads the file. One rename then replaces the old .htaccess, and that
# rename switches the site to the new release.
# Every request goes to the www/ folder of the live release, so releases/,
# shared/ and backups/ cannot be reached from outside. www/.htaccess holds
# Kirby's rules.
# The rule names the release folder, not the symlink `current`. PHP caches
# a resolved symlink for up to 2 minutes (realpath_cache_ttl), so running
# PHP processes would see a switch of the symlink that late.

RewriteEngine On

# Let's Encrypt checks the domain through a file under /.well-known/ in this
# folder (HTTP-01 challenge), so that path is not rewritten.
RewriteRule ^\.well-known/ - [L]

# The site folder also answers under other host names. A request for any of
# them gets a 301 to the same path on sven.eisenschmidt.website.
RewriteCond %{HTTP_HOST} !^sven\.eisenschmidt\.website$ [NC]
RewriteRule ^(.*)$ https://sven.eisenschmidt.website/$1 [R=301,L]

RewriteRule ^(.*)$ releases/RELEASE_ID/www/$1 [L]
