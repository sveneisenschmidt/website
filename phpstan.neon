parameters:
    level: 6
    paths:
        - src
        - www/site/plugins/analytics
        - www/site/plugins/assistant
        - www/site/plugins/blog
        - www/site/plugins/changelog
        - www/site/plugins/likes
        - www/site/plugins/save-retry
        - www/site/config
        - www/site/controllers
        - www/site/templates
        - www/site/snippets
        - bin
        - tests
    excludePaths:
        - www/site/config/env.php (?)
    bootstrapFiles:
        - vendor/autoload.php
        - www/kirby/bootstrap.php
    ignoreErrors:
        # Kirby resolves content fields ($page->cover(), $site->title()) and
        # the methods of a file as an image ($file->dimensions()) in the
        # magic method __call. PHPStan cannot see these methods. The page
        # models in src/Models declare their fields with @method, so calls
        # on a model stay checked.
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Kirby\\Cms\\(Page|Site|File|ModelWithContent)(\|Kirby\\Cms\\FileVersion)?::#'
        # Field methods ($field->toDate()) are registered at runtime.
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Kirby\\Content\\Field::#'
        # Kirby's Session passes these methods on to its data.
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Kirby\\Session\\Session::(get|set|increment|decrement|pull|remove|clear)\(\)\.$#'
        # Kirby binds a route closure to the route object, so $this exists
        # when the route runs.
        -
            identifier: variable.undefined
            message: '#^Undefined variable: \$this$#'
            paths:
                - www/site/config/routes.php
                - www/site/plugins/assistant/index.php
        # PHP sets $argv in every command line script.
        -
            identifier: variable.undefined
            message: '#^Variable \$argv might not be defined\.$#'
